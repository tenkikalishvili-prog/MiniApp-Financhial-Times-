# Скопируй этот файл в .env и вставь свой токен из BotFather.
# Файл .env в git НЕ попадает (см. .gitignore).

# Токен бота @FinTimes_money_bot (из BotFather)
BOT_TOKEN=вставь_сюда_токен

# База данных. Локально — файл SQLite (ничего настраивать не нужно).
# На проде (Railway) переменную DATABASE_URL задаёт сам Postgres —
# код сам приведёт её к нужному async-формату (см. backend/db.py).
DATABASE_URL=sqlite+aiosqlite:///fintimes.db
